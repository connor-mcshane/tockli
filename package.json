{
  "name": "tockli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tockli": "./cli/tockli.mjs"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:netlify": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "NEXT_PUBLIC_SUPABASE_URL=https://test.supabase.co NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && NEXT_PUBLIC_SUPABASE_URL=https://test.supabase.co NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test node --test tests/rendered-html.test.mjs tests/workspace-ui.test.mjs tests/focus-score.test.mjs tests/focus-score-estimator.test.mjs tests/analytics-privacy.test.mjs",
    "test:prod": "NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL:-https://test.supabase.co} NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:-sb_publishable_test} pnpm run build:netlify && NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL:-https://test.supabase.co} NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:-sb_publishable_test} node tests/production-smoke.mjs",
    "test:db": "node --test tests/local-supabase.test.mjs",
    "test:tockli": "node --test tests/tockli-auth.test.mjs tests/tockli-api.test.mjs tests/local-integration-safety.test.mjs tests/tockli-cli.test.mjs tests/workspace-sync.test.mjs",
    "test:tockli:cli": "node --test tests/tockli-cli.test.mjs",
    "test:tockli:cli:integration": "node --test tests/tockli-cli.local.test.mjs",
    "test:tockli:integration": "node --test tests/tockli-api.local.test.mjs",
    "test:tockli:mcp": "node --test tests/tockli-mcp.local.test.mjs",
    "test:tockli:realtime": "node --test tests/tockli-realtime.local.test.mjs",
    "test:tockli:sync": "node --test tests/workspace-sync.test.mjs",
    "test:tockli:tools": "pnpm run test:tockli:cli && pnpm run test:tockli:mcp",
    "test:tockli:local": "pnpm run test:tockli && pnpm run test:db && pnpm run test:tockli:integration && pnpm run test:tockli:cli:integration && pnpm run test:tockli:mcp && pnpm run test:tockli:realtime",
    "test:ui": "node --test tests/workspace-ui.test.mjs",
    "test:all": "pnpm test && pnpm run test:db",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status -o env",
    "env:local": "node scripts/switch-env.mjs local",
    "env:hosted": "node scripts/switch-env.mjs hosted"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "posthog-js": "^1.413.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postgres": "^3.4.9",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "^2.109.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
