# Copy .env.localdb or .env.localsupabase to .env.local with one of the
# `pnpm run env:*` commands. Only .env.local is loaded by the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_EXPERIMENT_SALT=tockli-2026-launch
NEXT_PUBLIC_SIGNUP_ENDPOINT=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Server-only. Required for project invite creation and email delivery.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. When set, project invites use a branded transactional email instead
# of the Supabase Auth invite template.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
